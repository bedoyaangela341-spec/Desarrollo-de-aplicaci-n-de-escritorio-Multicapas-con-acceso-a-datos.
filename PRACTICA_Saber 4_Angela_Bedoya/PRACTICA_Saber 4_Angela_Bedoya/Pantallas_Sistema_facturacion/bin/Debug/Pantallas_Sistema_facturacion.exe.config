<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    IMPORTANTE:
    - Ajuste "Data Source" con el nombre de su instancia de SQL Server
      (por ejemplo: .\SQLEXPRESS, localhost, o el nombre del servidor).
    - Ajuste "Initial Catalog" con el nombre que le dio a la base de datos
      al restaurar el archivo BACKUP_BD_FACTURAS.BAK (por defecto DBFACTURAS).
    - Si usa autenticación de SQL Server en vez de Windows, reemplace
      "Integrated Security=True" por "User Id=usuario;Password=clave;"
  -->
  <connectionStrings>
    <add name="cnFacturas"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=DBFACTURAS;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
</configuration>
